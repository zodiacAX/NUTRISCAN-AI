# ==========================================
# NutriScan AI — Environment Variables
# ==========================================

# 1. Gemma 4 Multimodal Model Configuration
# Supported providers: demo | google_ai_studio | ollama
GEMMA_PROVIDER=demo
GEMMA_MODEL=gemma-4-27b-it
GEMMA_API_KEY=
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_SECONDS=25

# 2. Application & Server Settings
APP_NAME=NutriScan AI
APP_VERSION=1.0.0
ENV=development
DEBUG=false
PORT=8000
HOST=127.0.0.1

# 3. Security Limits
# 10 MB maximum upload size
MAX_UPLOAD_SIZE_BYTES=10485760

# 4. Nutrition Database Configuration
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_TIMEOUT_SECONDS=6
