# NutriScan AI Environment Configuration

# Provider can be: demo, google_ai_studio, ollama, custom
GEMMA_PROVIDER=demo
GEMMA_MODEL=gemma-4-27b-it
GEMMA_API_KEY=
GEMMA_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMMA_TIMEOUT_SECONDS=25

# Environment
ENV=development
DEBUG=false

# Security & Limits
MAX_UPLOAD_SIZE_BYTES=10485760

# Nutrition Database
OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
OPENFOODFACTS_TIMEOUT_SECONDS=6
